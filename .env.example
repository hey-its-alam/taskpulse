POSTGRES_USER=taskpulse
POSTGRES_PASSWORD=change_me
POSTGRES_DB=taskpulse
DATABASE_URL=postgresql+psycopg2://taskpulse:change_me@postgres:5432/taskpulse
REDIS_URL=redis://redis:6379/0
OTLP_ENDPOINT=http://tempo:4317

# rate limiting
RATE_LIMIT_SUBMIT=30
RATE_LIMIT_READ=300
RATE_LIMIT_RETRY=10
RATE_LIMIT_WINDOW_SECONDS=60
MAX_QUEUE_DEPTH=500
TASK_RATE_LIMIT=120/m

# failure simulation
FAILURE_RATE=0.15
EXTRA_LATENCY_SECONDS=0

# grafana login
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change_me